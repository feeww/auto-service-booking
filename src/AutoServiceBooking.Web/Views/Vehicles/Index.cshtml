@model AutoServiceBooking.Web.ViewModels.VehicleIndexViewModel

@{
    ViewData["Title"] = "Мої автомобілі";

    string GetBookingsText(int count)
    {
        if (count == 0)
        {
            return "Немає записів";
        }

        int lastTwoDigits = count % 100;
        int lastDigit = count % 10;
        string word = lastTwoDigits is >= 11 and <= 14
            ? "записів"
            : lastDigit == 1
                ? "запис"
                : lastDigit is >= 2 and <= 4
                    ? "записи"
                    : "записів";

        return $"{count} {word} в історії";
    }
}

<section class="cabinet-section">
    <div class="cabinet-header">
        <div>
            <p class="section-label">Особистий кабінет</p>
            <h1>Мої автомобілі</h1>
            <p>Додайте ваші автомобілі для швидкого оформлення нових заявок на сервіс.</p>
        </div>

        <a class="primary-link" asp-action="Create">Додати автомобіль</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-message success-message">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-message error-message">@TempData["ErrorMessage"]</div>
    }

    <nav class="vehicle-tabs" aria-label="Фільтр автомобілів">
        <a class="vehicle-tab @(Model.ShowArchived ? string.Empty : "active")" asp-action="Index" asp-route-tab="active">
            Активні авто <span>@Model.ActiveCount</span>
        </a>
        <a class="vehicle-tab @(Model.ShowArchived ? "active" : string.Empty)" asp-action="Index" asp-route-tab="archive">
            Архів <span>@Model.ArchivedCount</span>
        </a>
    </nav>

    @if (!Model.Vehicles.Any())
    {
        <div class="empty-state">
            @if (Model.ShowArchived)
            {
                <h2>Архів порожній</h2>
                <p>Сюди потрапляють авто, які вже не використовуються для нових записів, але мають історію сервісу.</p>
            }
            else
            {
                <h2>Автомобілів ще немає</h2>
                <p>Додайте перше авто: марку, модель, номерний знак, пробіг і тип пального.</p>
                <a class="primary-link" asp-action="Create">Додати автомобіль</a>
            }
        </div>
    }
    else
    {
        <div class="vehicle-list">
            @foreach (var vehicle in Model.Vehicles)
            {
                <article class="vehicle-list-card @(vehicle.IsArchived ? "vehicle-archived-card" : string.Empty)">
                    <div>
                        <span class="vehicle-plate">@vehicle.LicensePlate</span>
                        <h2>@vehicle.Make @vehicle.Model</h2>
                        <p>@vehicle.Year рік · @vehicle.FuelTypeName · @vehicle.Mileage км</p>
                    </div>

                    <div class="vehicle-meta">
                        <span>@GetBookingsText(vehicle.BookingsCount)</span>
                    </div>

                    <div class="card-actions">
                        @if (vehicle.IsArchived)
                        {
                            <form asp-action="Restore" asp-route-id="@vehicle.Id" method="post">
                                <button class="link-action-button" type="submit">Повернути</button>
                            </form>
                        }
                        else
                        {
                            <a asp-action="Edit" asp-route-id="@vehicle.Id">Редагувати</a>
                            <a class="danger-link" asp-action="Delete" asp-route-id="@vehicle.Id">@(vehicle.BookingsCount > 0 ? "В архів" : "Видалити")</a>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
