@model List<AutoServiceBooking.Web.ViewModels.BookingListItemViewModel>

@{
    ViewData["Title"] = "Заявки клієнтів";
}

<section class="cabinet-section">
    <div class="cabinet-header">
        <div>
            <p class="section-label">Адмін-панель</p>
            <h1>Заявки клієнтів</h1>
            <p>Підтверджуйте записи, переводьте роботи в процес і завершуйте їх з фінальною ціною.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert-message success-message">@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert-message error-message">@errorMessage</div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h2>Заявок поки немає</h2>
            <p>Нові онлайн-записи клієнтів з'являться на цій сторінці.</p>
        </div>
    }
    else
    {
        <div class="booking-list admin-booking-list">
            @foreach (var booking in Model)
            {
                <article class="booking-list-card admin-booking-card">
                    <div class="booking-card-main">
                        <div class="booking-card-title-row admin-title-row">
                            <div>
                                <div class="booking-meta-line">
                                    <span class="booking-number">Заявка #@booking.Id</span>
                                    <span class="booking-status @booking.StatusCssClass">@booking.StatusName</span>
                                </div>
                                <h2>@booking.AutoServiceName</h2>
                            </div>
                        </div>

                        <dl class="booking-details-grid admin-details-grid">
                            <div>
                                <dt>Дата та час</dt>
                                <dd>@booking.ScheduledAt.ToString("dd.MM.yyyy HH:mm")</dd>
                            </div>
                            <div>
                                <dt>Клієнт</dt>
                                <dd>@booking.CustomerName</dd>
                            </div>
                            <div>
                                <dt>Телефон</dt>
                                <dd>@booking.CustomerPhone</dd>
                            </div>
                            <div>
                                <dt>Email</dt>
                                <dd>@(booking.CustomerEmail ?? "Не вказано")</dd>
                            </div>
                            <div>
                                <dt>Авто</dt>
                                <dd>@booking.VehicleTitle</dd>
                            </div>
                            <div>
                                <dt>Фінальна ціна</dt>
                                <dd>@(booking.FinalPrice.HasValue ? $"{booking.FinalPrice:0} грн" : "Ще не визначено")</dd>
                            </div>
                        </dl>

                        @if (!string.IsNullOrWhiteSpace(booking.ProblemDescription))
                        {
                            <p class="booking-description"><strong>Опис клієнта:</strong> @booking.ProblemDescription</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(booking.AdminComment))
                        {
                            <p class="booking-admin-comment"><strong>Коментар:</strong> @booking.AdminComment</p>
                        }
                    </div>

                    <div class="admin-booking-actions">
                        @if (booking.CanConfirm)
                        {
                            <form asp-action="Confirm" asp-route-id="@booking.Id" method="post">
                                <button class="action-button action-primary" type="submit">Підтвердити</button>
                            </form>

                            <form asp-action="Reject" asp-route-id="@booking.Id" method="post">
                                <button class="action-button action-danger" type="submit">Відхилити</button>
                            </form>
                        }

                        @if (booking.CanStartWork)
                        {
                            <form asp-action="StartWork" asp-route-id="@booking.Id" method="post">
                                <button class="action-button action-primary" type="submit">Почати роботу</button>
                            </form>
                        }

                        @if (booking.CanComplete)
                        {
                            <form class="complete-booking-form" asp-action="Complete" asp-route-id="@booking.Id" method="post">
                                <input name="finalPrice" type="number" min="0" step="0.01" placeholder="Фінальна ціна" required />
                                <textarea name="adminComment" rows="2" placeholder="Коментар для клієнта"></textarea>
                                <button class="action-button action-primary" type="submit">Завершити</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
