@model AutoServiceBooking.Web.ViewModels.BookingListPageViewModel

@{
    ViewData["Title"] = "Заявки клієнтів";
}

<section class="cabinet-section">
    <div class="cabinet-header">
        <div>
            <p class="section-label">Адмін-панель</p>
            <h1>Заявки клієнтів</h1>
            <p>Підтверджуйте записи, переводьте роботи в процес і завершуйте їх з фінальною ціною.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert-message success-message">@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert-message error-message">@errorMessage</div>
    }

    <nav class="vehicle-tabs admin-tabs" aria-label="Адмінські розділи">
        <a class="vehicle-tab active" asp-action="Admin">Заявки <span>@Model.TotalItems</span></a>
        <a class="vehicle-tab" asp-action="Schedule">Розклад</a>
    </nav>

    <form class="booking-filter-form" method="get">
        <div class="booking-filter-field">
            <label for="search">Пошук</label>
            <input id="search" name="search" value="@Model.Search" placeholder="Номер (#15), клієнт, телефон, email або авто" />
        </div>

        <div class="booking-filter-field">
            <label for="status">Статус</label>
            <select id="status" name="status">
                <option value="">Усі статуси</option>
                @foreach (var option in Model.StatusOptions)
                {
                    if (Model.Status?.ToString() == option.Value)
                    {
                        <option value="@option.Value" selected>@option.Text</option>
                    }
                    else
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                }
            </select>
        </div>

        <div class="booking-filter-field">
            <label for="sort">Сортування</label>
            <select id="sort" name="sort">
                @foreach (var option in Model.SortOptions)
                {
                    if (Model.Sort == option.Value)
                    {
                        <option value="@option.Value" selected>@option.Text</option>
                    }
                    else
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                }
            </select>
        </div>

        <div class="booking-filter-actions">
            <button class="action-button action-primary" type="submit">Знайти</button>
            @if (Model.HasFilters)
            {
                <a class="secondary-link" asp-action="Admin">Скинути</a>
            }
        </div>
    </form>

    @if (!Model.Bookings.Any())
    {
        <div class="empty-state">
            @if (Model.HasFilters)
            {
                <h2>Заявок не знайдено</h2>
                <p>Спробуйте змінити пошук або скинути фільтри.</p>
                <a class="primary-link" asp-action="Admin">Скинути фільтри</a>
            }
            else
            {
                <h2>Заявок поки немає</h2>
                <p>Нові онлайн-записи клієнтів з'являться на цій сторінці.</p>
            }
        </div>
    }
    else
    {
        <div class="booking-list admin-booking-list">
            @foreach (var booking in Model.Bookings)
            {
                <article class="booking-list-card admin-booking-card">
                    <div class="booking-card-main">
                        <div class="booking-card-title-row admin-title-row">
                            <div>
                                <div class="booking-meta-line">
                                    <span class="booking-number">Заявка #@booking.Id</span>
                                    <span class="booking-status @booking.StatusCssClass">@booking.StatusName</span>
                                </div>
                                <h2>@booking.AutoServiceName</h2>
                            </div>
                        </div>

                        <dl class="booking-details-grid admin-details-grid">
                            <div>
                                <dt>Дата та час</dt>
                                <dd>@booking.ScheduledAt.ToString("dd.MM.yyyy HH:mm")</dd>
                            </div>
                            <div>
                                <dt>Клієнт</dt>
                                <dd>@booking.CustomerName</dd>
                            </div>
                            <div>
                                <dt>Телефон</dt>
                                <dd>@booking.CustomerPhone</dd>
                            </div>
                            <div>
                                <dt>Email</dt>
                                <dd>@(booking.CustomerEmail ?? "Не вказано")</dd>
                            </div>
                            <div>
                                <dt>Авто</dt>
                                <dd>@booking.VehicleTitle</dd>
                            </div>
                            <div>
                                <dt>Фінальна ціна</dt>
                                <dd>@(booking.FinalPrice.HasValue ? $"{booking.FinalPrice:0} грн" : "Ще не визначено")</dd>
                            </div>
                            <div>
                                <dt>Орієнтовна ціна</dt>
                                <dd>@(booking.EstimatedPrice.HasValue ? $"{booking.EstimatedPrice:0} грн" : booking.IsClosedWithoutEstimate ? "Не вказано" : "Після підтвердження")</dd>
                            </div>
                            <div>
                                <dt>Орієнтовний час</dt>
                                <dd>@(booking.EstimatedDurationMinutes.HasValue ? $"{booking.EstimatedDurationMinutes} хв" : booking.IsClosedWithoutEstimate ? "Не вказано" : "Після підтвердження")</dd>
                            </div>
                        </dl>

                        @if (!string.IsNullOrWhiteSpace(booking.ProblemDescription))
                        {
                            <p class="booking-description"><strong>Опис клієнта:</strong> @booking.ProblemDescription</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(booking.AdminComment))
                        {
                            <p class="booking-admin-comment"><strong>Коментар:</strong> @booking.AdminComment</p>
                        }
                    </div>

                    <div class="admin-booking-actions">
                        @if (booking.CanConfirm)
                        {
                            <form class="confirm-booking-form" asp-action="Confirm" asp-route-id="@booking.Id" method="post">
                                <label for="estimatedPrice-@booking.Id">Підтвердження</label>
                                <input id="estimatedPrice-@booking.Id" name="estimatedPrice" type="number" min="0" step="0.01" placeholder="Орієнтовна ціна" value="@(booking.AutoServicePrice > 0 ? booking.AutoServicePrice.ToString("0.##") : null)" required />
                                <input name="estimatedDurationMinutes" type="number" min="1" step="1" placeholder="Час, хв" required />
                                <button class="action-button action-primary" type="submit">Підтвердити</button>
                            </form>
                        }

                        @if (booking.CanReject)
                        {
                            <form asp-action="Reject" asp-route-id="@booking.Id" method="post">
                                <button class="action-button action-danger" type="submit">Відхилити</button>
                            </form>
                        }

                        @if (booking.CanReschedule)
                        {
                            <details class="reschedule-details">
                                <summary class="action-button action-secondary">Перенести</summary>
                                <form class="reschedule-booking-form"
                                      asp-action="Reschedule"
                                      asp-route-id="@booking.Id"
                                      method="post"
                                      data-admin-reschedule-form
                                      data-booking-id="@booking.Id"
                                      data-duration-minutes="@booking.RescheduleDurationMinutes">
                                    <label for="scheduledAt-@booking.Id">Новий час</label>
                                    <input id="rescheduleDate-@booking.Id"
                                           type="date"
                                           value="@booking.ScheduledAt.ToString("yyyy-MM-dd")"
                                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           data-admin-reschedule-date />
                                    <input id="scheduledAt-@booking.Id"
                                           name="scheduledAt"
                                           type="hidden"
                                           value="@booking.ScheduledAt.ToString("yyyy-MM-ddTHH:mm")"
                                           data-admin-reschedule-value
                                           required />
                                    <div class="time-slot-grid admin-time-slot-grid" data-admin-reschedule-slots></div>
                                    <span class="validation-error calendar-warning is-hidden" data-admin-reschedule-warning></span>
                                    <p class="time-slot-helper" data-admin-reschedule-helper>Оберіть дату та час.</p>
                                    <div class="reschedule-form-actions">
                                        <button class="action-button action-secondary" type="submit">Зберегти</button>
                                        <button class="action-button action-muted" type="button" data-admin-reschedule-close>Закрити</button>
                                    </div>
                                </form>
                            </details>
                        }

                        @if (booking.CanStartWork)
                        {
                            <form class="start-work-action" asp-action="StartWork" asp-route-id="@booking.Id" method="post">
                                <button class="action-button action-primary" type="submit">Почати роботу</button>
                            </form>
                        }

                        @if (booking.CanComplete)
                        {
                            <form class="complete-booking-form" asp-action="Complete" asp-route-id="@booking.Id" method="post">
                                <input name="finalPrice" type="number" min="0" step="0.01" placeholder="Фінальна ціна" required />
                                <textarea name="adminComment" rows="2" placeholder="Коментар для клієнта"></textarea>
                                <button class="action-button action-primary" type="submit">Завершити</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>

        <div class="pagination-bar">
            <p>Показано @Model.FirstItemNumber–@Model.LastItemNumber із @Model.TotalItems</p>

            @if (Model.TotalPages > 1)
            {
                <nav class="pagination-links" aria-label="Сторінки заявок">
                    @if (Model.HasPreviousPage)
                    {
                        <a asp-action="Admin" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page - 1)">Назад</a>
                    }
                    else
                    {
                        <span class="disabled">Назад</span>
                    }

                    <span class="current-page">@Model.Page з @Model.TotalPages</span>

                    @if (Model.HasNextPage)
                    {
                        <a asp-action="Admin" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page + 1)">Далі</a>
                    }
                    else
                    {
                        <span class="disabled">Далі</span>
                    }
                </nav>
            }
        </div>
    }

    @foreach (var blockedDate in Model.BlockedDates)
    {
        <span class="is-hidden" data-admin-blocked-date="@blockedDate.DateValue" data-admin-blocked-reason="@blockedDate.Reason"></span>
    }

    @foreach (var occupiedInterval in Model.OccupiedIntervals)
    {
        <span class="is-hidden"
              data-admin-occupied-booking-id="@occupiedInterval.BookingId"
              data-admin-occupied-date="@occupiedInterval.DateValue"
              data-admin-occupied-start="@occupiedInterval.StartTime"
              data-admin-occupied-end="@occupiedInterval.EndTime"
              data-admin-occupied-label="@occupiedInterval.Label"></span>
    }

    <span class="is-hidden"
          data-admin-work-day-start="@(Model.WorkDayStartHour * 60)"
          data-admin-work-day-end="@(Model.WorkDayEndHour * 60)"
          data-admin-slot-step="@Model.SlotStepMinutes"></span>
</section>
